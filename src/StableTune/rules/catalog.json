{
  "schemaVersion": "1.0",
  "rules": [
    {
      "id": "power-plan",
      "category": "power_cpu",
      "name": "创建并启用低延迟电源方案",
      "description": "复制当前电源方案，创建独立的 StableTune Low Latency 方案并启用。",
      "risk": "safe",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["powercfg 可用", "存在可读取的活动电源方案"],
      "snapshotKind": "power_scheme",
      "handler": "PowerPlan"
    },
    {
      "id": "power-processor-min",
      "category": "power_cpu",
      "name": "AC 模式处理器最低状态设为 100%",
      "description": "减少处理器频率升降带来的响应波动，会增加功耗与发热。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["电源方案允许修改处理器设置"],
      "snapshotKind": "power_setting",
      "handler": "ProcessorMinimum"
    },
    {
      "id": "power-usb-suspend",
      "category": "power_cpu",
      "name": "禁用 USB 选择性暂停",
      "description": "避免 USB 设备在空闲时进入选择性暂停。",
      "risk": "safe",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["当前电源方案提供 USB 选择性暂停设置"],
      "snapshotKind": "power_setting",
      "handler": "UsbSelectiveSuspend"
    },
    {
      "id": "power-pcie-aspm",
      "category": "power_cpu",
      "name": "禁用 PCI Express 链接状态电源管理",
      "description": "关闭 PCIe ASPM，可能改善响应并增加待机功耗。",
      "risk": "safe",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["当前电源方案提供 PCIe 链接状态设置"],
      "snapshotKind": "power_setting",
      "handler": "PcieAspm"
    },
    {
      "id": "scheduler-priority-separation",
      "category": "latency_scheduler",
      "name": "前台任务调度参数",
      "description": "将 Win32PrioritySeparation 设置为 0x28，增强前台短时间片调度。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": true,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["可写入 PriorityControl 注册表键"],
      "snapshotKind": "registry",
      "handler": "PrioritySeparation"
    },
    {
      "id": "scheduler-multimedia",
      "category": "latency_scheduler",
      "name": "多媒体与网络节流参数",
      "description": "关闭多媒体网络节流并取消系统预留响应预算。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["可写入 Multimedia SystemProfile 注册表键"],
      "snapshotKind": "registry_multi",
      "handler": "MultimediaProfile"
    },
    {
      "id": "scheduler-bcd-timers",
      "category": "latency_scheduler",
      "name": "BCD 计时器策略",
      "description": "设置 useplatformtick=no 与 disabledynamictick=yes，需要重启验证。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": true,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["bcdedit 可用", "启动项允许执行 bcdedit"],
      "snapshotKind": "bcd",
      "handler": "BcdTimers"
    },
    {
      "id": "network-nic-power",
      "category": "network",
      "name": "禁用所选网卡省电",
      "description": "阻止 Windows 为节省电力关闭所选网络适配器。",
      "risk": "safe",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": true,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["至少存在一个物理网络适配器"],
      "snapshotKind": "registry",
      "handler": "NicPower"
    },
    {
      "id": "network-tcp-autotuning",
      "category": "network",
      "name": "TCP 自动调优设为 experimental",
      "description": "使用 Windows 的实验性接收窗口自动调优级别。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["netsh int tcp 可用"],
      "snapshotKind": "tcp_global",
      "handler": "TcpAutotuning"
    },
    {
      "id": "network-tcp-timestamps",
      "category": "network",
      "name": "启用 TCP 时间戳",
      "description": "启用 TCP timestamps，用于更精确的往返时间测量。",
      "risk": "safe",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["netsh int tcp 可用"],
      "snapshotKind": "tcp_global",
      "handler": "TcpTimestamps"
    },
    {
      "id": "network-dns",
      "category": "network",
      "name": "应用网卡 DNS 配置",
      "description": "为指定网卡恢复 DHCP DNS 或应用用户选择的手动 DNS。",
      "risk": "safe",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": true,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["目标网卡存在"],
      "snapshotKind": "dns",
      "handler": "DnsProfile"
    },
    {
      "id": "graphics-amd-pstate",
      "category": "graphics",
      "name": "AMD 动态 P-State 修复",
      "description": "在匹配的 AMD 显示驱动子键上设置 DisableDynamicPstate。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": true,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["检测到匹配的 AMD 显示适配器驱动子键"],
      "snapshotKind": "registry",
      "handler": "AmdDynamicPstate"
    },
    {
      "id": "startup-toggle",
      "category": "startup_services",
      "name": "启用或禁用启动项",
      "description": "将所选 Run 启动项移动到程序管理的停用键，恢复时移回原位。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": true,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["目标启动项来自受支持的 Run 或 RunOnce 注册表键"],
      "snapshotKind": "startup",
      "handler": "StartupItem"
    },
    {
      "id": "services-allowlist",
      "category": "startup_services",
      "name": "调整允许列表中的服务",
      "description": "修改所选服务的启动类型，并按选项停止当前实例。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": true,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["服务存在且属于允许列表"],
      "snapshotKind": "service",
      "handler": "ServiceState"
    },
    {
      "id": "storage-temp-quarantine",
      "category": "storage",
      "name": "隔离用户临时文件",
      "description": "将七天前且未被占用的临时文件移动到可恢复隔离区。",
      "risk": "safe",
      "requiresAdmin": false,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["用户临时目录可读取"],
      "snapshotKind": "quarantine",
      "handler": "TempQuarantine"
    },
    {
      "id": "hardware-device-affinity",
      "category": "hardware_binding",
      "name": "设备中断与核心亲和性",
      "description": "为所选设备保存并应用中断策略和 CPU 核心掩码。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": true,
      "requiresInput": true,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["设备支持中断策略属性", "用户选择有效 CPU 掩码"],
      "snapshotKind": "device_policy",
      "handler": "DeviceAffinity"
    },
    {
      "id": "power-core-parking-min",
      "category": "power_cpu",
      "name": "禁用处理器核心停放",
      "description": "将活动电源方案的 AC 核心停放最小核心数设为 100%。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["活动电源方案提供处理器核心停放设置"],
      "snapshotKind": "power_setting",
      "handler": "CoreParkingMinimum"
    },
    {
      "id": "power-cpu-idle-disable",
      "category": "power_cpu",
      "name": "禁用处理器空闲状态",
      "description": "将活动电源方案的 AC 处理器空闲禁用值设为 1。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["活动电源方案和固件允许修改处理器空闲状态"],
      "snapshotKind": "power_setting",
      "handler": "CpuIdleDisable"
    },
    {
      "id": "power-heterogeneous-policy-drift",
      "category": "power_cpu",
      "name": "修复异类调度与性能提升模式漂移",
      "description": "对照 Windows 内置高性能或平衡方案的默认值，修复 HETEROPOLICY、SCHEDPOLICY、SHORTSCHEDPOLICY 和 PERFBOOSTMODE 漂移。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["Windows 内置高性能或平衡方案可读取", "四个隐藏处理器电源设置均可解析默认值"],
      "snapshotKind": "power_multi",
      "handler": "HeterogeneousPowerPolicy"
    },
    {
      "id": "process-priority-ace",
      "category": "latency_scheduler",
      "name": "降低腾讯 ACE CPU 优先级",
      "description": "仅为 SGuard64.exe 和 SGuardSvc64.exe 写入 IFEO CpuPriorityClass=1；不修改 I/O 优先级。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["检测到腾讯 ACE 反作弊目录或进程", "可写 IFEO PerfOptions 注册表键"],
      "snapshotKind": "registry_multi",
      "handler": "RegistrySet",
      "prerequisiteKind": "AntiCheatExpert",
      "registryChanges": [
        {"path": "HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\SGuard64.exe\\PerfOptions", "name": "CpuPriorityClass", "kind": "DWord", "value": 1},
        {"path": "HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\SGuardSvc64.exe\\PerfOptions", "name": "CpuPriorityClass", "kind": "DWord", "value": 1}
      ],
      "changeSummary": ["仅将两个 ACE 进程的 CPU 优先级设为 Idle。", "明确不写入 IoPriority 或 PagePriority。"]
    },
    {
      "id": "process-priority-game",
      "category": "latency_scheduler",
      "name": "设置指定游戏 EXE 的 CPU 优先级",
      "description": "为所选游戏 EXE 写入 IFEO CpuPriorityClass，可选择 Normal 或 Above normal。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": true,
      "inputKind": "ExecutablePriority",
      "platform": "Windows 10/11 x64",
      "prerequisites": ["用户选择一个存在的游戏或应用 EXE", "优先级别仅允许 Normal 或 Above normal"],
      "snapshotKind": "registry_multi",
      "handler": "RegistrySet",
      "registryChanges": [
        {"path": "HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\{ExecutableName}\\PerfOptions", "name": "CpuPriorityClass", "kind": "DWord", "value": "{CpuPriorityClass}"}
      ],
      "changeSummary": ["仅为所选 EXE 写入 CPU 优先级。", "不修改 I/O 优先级、进程亲和性或反作弊组件。"]
    },
    {
      "id": "input-mouse-acceleration",
      "category": "input_response",
      "name": "关闭鼠标指针加速",
      "description": "关闭 Windows 的增强指针精度和鼠标加速度阈值。",
      "risk": "safe",
      "requiresAdmin": false,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["当前用户可写入 HKCU 鼠标设置"],
      "snapshotKind": "registry_multi",
      "handler": "RegistrySet",
      "registryChanges": [
        {"path": "HKCU:\\Control Panel\\Mouse", "name": "MouseSpeed", "kind": "String", "value": "0"},
        {"path": "HKCU:\\Control Panel\\Mouse", "name": "MouseThreshold1", "kind": "String", "value": "0"},
        {"path": "HKCU:\\Control Panel\\Mouse", "name": "MouseThreshold2", "kind": "String", "value": "0"}
      ],
      "changeSummary": ["将鼠标速度和两个加速度阈值设置为 0。"]
    },
    {
      "id": "graphics-game-mode",
      "category": "graphics",
      "name": "启用 Windows 游戏模式",
      "description": "允许 Windows 为当前游戏分配更稳定的 CPU 和 GPU 调度资源。",
      "risk": "safe",
      "requiresAdmin": false,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["当前用户可写入 GameBar 设置"],
      "snapshotKind": "registry_multi",
      "handler": "RegistrySet",
      "registryChanges": [
        {"path": "HKCU:\\Software\\Microsoft\\GameBar", "name": "AutoGameModeEnabled", "kind": "DWord", "value": 1},
        {"path": "HKCU:\\Software\\Microsoft\\GameBar", "name": "AllowAutoGameMode", "kind": "DWord", "value": 1}
      ],
      "changeSummary": ["启用自动游戏模式和游戏模式许可。"]
    },
    {
      "id": "graphics-game-dvr-disable",
      "category": "graphics",
      "name": "关闭后台游戏录制",
      "description": "关闭 Xbox Game Bar 后台录制和游戏 DVR 策略。",
      "risk": "safe",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["当前用户和系统策略键可写"],
      "snapshotKind": "registry_multi",
      "handler": "RegistrySet",
      "registryChanges": [
        {"path": "HKCU:\\System\\GameConfigStore", "name": "GameDVR_Enabled", "kind": "DWord", "value": 0},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR", "name": "AppCaptureEnabled", "kind": "DWord", "value": 0},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR", "name": "AllowGameDVR", "kind": "DWord", "value": 0}
      ],
      "changeSummary": ["关闭游戏 DVR、后台捕获和系统级 Game DVR 许可。"]
    },
    {
      "id": "graphics-hags",
      "category": "graphics",
      "name": "启用 GPU 硬件加速调度",
      "description": "将 HwSchMode 设置为 2，启用受支持的 GPU 硬件加速调度。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": true,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["Windows 10 2004+ 或 Windows 11", "GPU 与驱动支持 WDDM 2.7+"],
      "snapshotKind": "registry_multi",
      "handler": "RegistrySet",
      "registryChanges": [
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers", "name": "HwSchMode", "kind": "DWord", "value": 2}
      ],
      "changeSummary": ["将 GPU 硬件加速调度模式设置为启用。"]
    },
    {
      "id": "graphics-mpo-disable",
      "category": "graphics",
      "name": "关闭多平面覆盖 MPO",
      "description": "设置 OverlayTestMode=5，用于规避部分驱动的 MPO 闪烁和卡顿问题。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": true,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["DWM 注册表键可写", "仅建议用于确认存在 MPO 问题的设备"],
      "snapshotKind": "registry_multi",
      "handler": "RegistrySet",
      "registryChanges": [
        {"path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\Dwm", "name": "OverlayTestMode", "kind": "DWord", "value": 5}
      ],
      "changeSummary": ["将 DWM OverlayTestMode 设置为 5。"]
    },
    {
      "id": "graphics-fullscreen-optimizations",
      "category": "graphics",
      "name": "关闭指定程序的全屏优化",
      "description": "为所选 EXE 写入兼容性层标记，关闭全屏优化。",
      "risk": "advanced",
      "requiresAdmin": false,
      "requiresRestart": false,
      "requiresInput": true,
      "inputKind": "ExecutablePath",
      "platform": "Windows 10/11 x64",
      "prerequisites": ["用户选择一个存在的游戏或应用 EXE"],
      "snapshotKind": "registry",
      "handler": "RegistrySet",
      "registryChanges": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Layers", "name": "{ExecutablePath}", "kind": "String", "value": "~ DISABLEDXMAXIMIZEDWINDOWEDMODE"}
      ],
      "changeSummary": ["为所选程序关闭全屏优化。"]
    },
    {
      "id": "network-nagle-disable",
      "category": "network",
      "name": "关闭所选网卡 Nagle 合并",
      "description": "在所选网络接口上设置 TcpAckFrequency=1 和 TCPNoDelay=1。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": true,
      "inputKind": "NetworkAdapter",
      "platform": "Windows 10/11 x64",
      "prerequisites": ["至少存在一个物理或虚拟网络适配器"],
      "snapshotKind": "registry_multi",
      "handler": "RegistrySet",
      "registryChanges": [
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces\\{InterfaceGuid}", "name": "TcpAckFrequency", "kind": "DWord", "value": 1},
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters\\Interfaces\\{InterfaceGuid}", "name": "TCPNoDelay", "kind": "DWord", "value": 1}
      ],
      "changeSummary": ["关闭所选网卡的 Nagle 合并和延迟确认。"]
    },
    {
      "id": "network-netbios-disable",
      "category": "network",
      "name": "关闭所选网卡 NetBIOS",
      "description": "将所选接口的 NetbiosOptions 设置为 2，关闭 NetBIOS over TCP/IP。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": true,
      "inputKind": "NetworkAdapter",
      "platform": "Windows 10/11 x64",
      "prerequisites": ["目标接口存在", "不依赖旧式局域网名称解析和发现"],
      "snapshotKind": "registry_multi",
      "handler": "RegistrySet",
      "registryChanges": [
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters\\Interfaces\\Tcpip_{InterfaceGuid}", "name": "NetbiosOptions", "kind": "DWord", "value": 2}
      ],
      "changeSummary": ["关闭所选接口的 NetBIOS over TCP/IP。"]
    },
    {
      "id": "network-interrupt-moderation-disable",
      "category": "network",
      "name": "关闭所选网卡中断节流",
      "description": "通过网卡驱动公开的高级属性关闭中断节流。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": true,
      "inputKind": "NetworkAdapter",
      "platform": "Windows 10/11 x64",
      "prerequisites": ["网卡驱动公开 Interrupt Moderation 高级属性"],
      "snapshotKind": "nic_advanced_property",
      "handler": "NetworkInterruptModeration"
    },
    {
      "id": "storage-trim-enable",
      "category": "storage",
      "name": "确保 SSD TRIM 已启用",
      "description": "将 NTFS DisableDeleteNotify 设置为 0，恢复 SSD TRIM 通知。",
      "risk": "safe",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["系统盘或目标存储设备为 SSD/NVMe"],
      "snapshotKind": "registry_multi",
      "handler": "RegistrySet",
      "prerequisiteKind": "Ssd",
      "registryChanges": [
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FileSystem", "name": "DisableDeleteNotify", "kind": "DWord", "value": 0}
      ],
      "changeSummary": ["允许 Windows 向 SSD 发送 TRIM 删除通知。"]
    },
    {
      "id": "storage-last-access-disable",
      "category": "storage",
      "name": "关闭 NTFS 最后访问时间更新",
      "description": "将 NtfsDisableLastAccessUpdate 设置为 1，减少驱动器写入。",
      "risk": "safe",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["系统使用 NTFS"],
      "snapshotKind": "registry_multi",
      "handler": "RegistrySet",
      "registryChanges": [
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FileSystem", "name": "NtfsDisableLastAccessUpdate", "kind": "DWord", "value": 1}
      ],
      "changeSummary": ["停止为普通文件访问持续更新最后访问时间。"]
    },
    {
      "id": "services-sysmain-disable",
      "category": "startup_services",
      "name": "禁用 SysMain 服务",
      "description": "将 SysMain 设置为禁用并停止当前服务。",
      "risk": "advanced",
      "requiresAdmin": true,
      "requiresRestart": false,
      "requiresInput": false,
      "platform": "Windows 10/11 x64",
      "prerequisites": ["系统盘为 SSD 且不依赖 SuperFetch 预热"],
      "snapshotKind": "service",
      "handler": "ServiceFixed",
      "serviceName": "SysMain",
      "targetStartupType": "Disabled",
      "stopNow": true
    },
    {
      "id": "services-windows-search-disable",
