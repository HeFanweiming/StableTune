        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "systemDiskSsd", "value": true }
      ],
      "evidenceIds": ["microsoft-storage", "microsoft-fsutil"]
    },
    "sysmain-ssd": {
      "summary": "SSD 且内存充足时更合适；机械盘或小内存设备不建议",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "systemDiskSsd", "value": true },
        { "type": "minimumMemoryGiB", "value": 16, "mode": "prefer" }
      ],
      "evidenceIds": ["microsoft-storage", "microsoft-memory"]
    },
    "storage-ntfs": {
      "summary": "要求系统使用 NTFS，并确认没有审计或取证依赖",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "fileSystem", "values": ["NTFS"] }
      ],
      "evidenceIds": ["microsoft-fsutil"]
    },
    "search-user-choice": {
      "summary": "只有在用户不依赖系统搜索和文件索引时才适用",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "userDecision", "mode": "prefer", "message": "需确认开始菜单、文件资源管理器和 Outlook 搜索可接受变慢或停用。" }
      ],
      "evidenceIds": ["microsoft-search"]
    },
    "printer-aware": {
      "summary": "检测到打印机或扫描设备时需要人工确认是否仍要停用",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "printerCountMaximum", "value": 0, "mode": "prefer" }
      ],
      "evidenceIds": ["microsoft-print"]
    },
    "domain-aware": {
      "summary": "企业域设备应先遵循组织诊断与遥测策略",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "domainJoined", "value": false, "mode": "prefer" }
      ],
      "evidenceIds": ["microsoft-service-ports"]
    },
    "startup-delay-ssd": {
      "summary": "SSD 设备更适合，机械盘和大量启动项需要先测试",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
