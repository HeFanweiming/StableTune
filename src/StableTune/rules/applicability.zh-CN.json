  "profiles": {
    "windows-generic": {
      "summary": "Windows 10/11 x64 通用设置",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] }
      ],
      "evidenceIds": ["microsoft-windows"]
    },
    "power-desktop-preferred": {
      "summary": "电源与处理器参数，台式机收益和稳定性更高",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "systemType", "values": ["Desktop"], "mode": "prefer" }
      ],
      "evidenceIds": ["microsoft-powercfg"]
    },
    "heterogeneous-power-policy": {
      "summary": "仅按 Windows 内置方案恢复隐藏处理器调度基线，台式机优先且不做永久锁定承诺",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "systemType", "values": ["Desktop"], "mode": "prefer" },
        { "type": "userDecision", "mode": "prefer", "message": "确认希望恢复隐藏处理器调度项，并接受游戏或厂商工具以后可能再次修改它们。" }
      ],
      "evidenceIds": ["microsoft-hetero-power-scheduling", "microsoft-perfboostmode"]
    },
    "ace-process-priority": {
      "summary": "仅在检测到腾讯 ACE 组件时允许单独调整其 CPU 调度优先级",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "antiCheatExpertInstalled", "value": true }
      ],
      "evidenceIds": ["microsoft-process-scheduling"]
    },
    "game-process-priority": {
      "summary": "必须选择具体游戏 EXE，且只允许 Normal 或 Above normal 优先级",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "selection", "kind": "ExecutablePriority" }
      ],
      "evidenceIds": ["microsoft-process-scheduling"]
    },
    "bcd-advanced": {
      "summary": "需要重启验证，并依赖固件和主板计时器实现",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "userDecision", "mode": "prefer" }
      ],
      "evidenceIds": ["microsoft-bcd", "microsoft-event41"]
    },
    "network-adapter": {
      "summary": "必须选择具体网卡并检查驱动属性",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "selection", "kind": "NetworkAdapter" }
      ],
      "evidenceIds": ["microsoft-tcp", "ietf-rfc9293"]
    },
    "network-experimental": {
      "summary": "实验性网络参数，只适合明确进行对照测试的设备",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "userDecision", "mode": "prefer" }
      ],
      "evidenceIds": ["microsoft-tcp", "ietf-rfc9293"]
    },
    "network-netbios": {
      "summary": "仅在设备不依赖旧式局域网发现和 NetBIOS 名称时适用",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "userDecision", "mode": "prefer", "message": "需确认局域网共享、NAS 和旧应用不依赖 NetBIOS。" }
      ],
      "evidenceIds": ["microsoft-service-ports"]
    },
    "graphics-amd": {
      "summary": "仅适用于存在匹配 AMD 显示驱动子键的设备",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "gpuVendor", "values": ["AMD"] }
      ],
      "evidenceIds": ["microsoft-wddm"]
    },
    "graphics-hags": {
      "summary": "Windows 10 2004+、WDDM 2.7+ 且显卡和驱动支持硬件加速调度",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "minimumBuild", "value": 19041 },
        { "type": "gpuVendor", "values": ["AMD", "NVIDIA", "Intel"] },
        { "type": "wddmMinimum", "value": 2.7 }
      ],
      "evidenceIds": ["microsoft-hags", "microsoft-wddm"]
    },
    "graphics-mpo": {
      "summary": "仅作为已出现 MPO 闪烁、黑屏或卡顿后的故障规避项",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "userDecision", "mode": "prefer", "message": "正常显示设备不建议关闭 MPO，必须先确认问题可复现。" }
      ],
      "evidenceIds": ["microsoft-wddm"]
    },
    "graphics-program": {
      "summary": "必须选择具体 EXE，并逐程序验证",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "selection", "kind": "ExecutablePath" }
      ],
      "evidenceIds": ["microsoft-wddm"]
    },
    "startup-selection": {
      "summary": "必须选择具体启动项或允许列表服务",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "selection", "kind": "StartupOrService" }
      ],
      "evidenceIds": ["microsoft-service-ports"]
    },
    "hardware-selection": {
      "summary": "必须结合具体设备、CPU 拓扑和中断共享情况逐项设置",
      "conditions": [
        { "type": "osFamily", "values": ["Windows 10", "Windows 11"] },
        { "type": "architecture", "values": ["x64"] },
        { "type": "selection", "kind": "Device" }
      ],
      "evidenceIds": ["microsoft-powercfg"]
    },
    "storage-ssd": {
      "summary": "仅适用于系统盘为 SSD/NVMe 且存储控制器支持对应功能",
